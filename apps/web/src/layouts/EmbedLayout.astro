---
// Layout for pages shown inside an <iframe> on other sites: no header, footer or service worker,
// only the module, the medical disclaimer, a link to the full page and the license.
import { locales } from '../i18n/locales.ts';
import { getMessages } from '../i18n/messages.ts';
import '../styles/base.css';

interface Props {
  locale: string;
  title: string;
  /** Absolute URL of the full page: canonical link and "open on the site". */
  canonical: URL;
}

const { locale, title, canonical } = Astro.props;
const t = getMessages(locale);
const dir = locales[locale]?.dir ?? 'ltr';
---

<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <!-- Links leave the frame: navigating inside a small iframe on someone else's page is useless. -->
    <base target="_blank" />
    <title>{`${title} · ${t['site.name']}`}</title>
    <slot name="head" />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <p class="disclaimer">{t['footer.disclaimer']}</p>
      <p>
        <a href={canonical} target="_blank" rel="noopener">
          {t['site.name']} · {t['embed.open']}
        </a>
        {' · '}
        {t['footer.license']}
      </p>
    </footer>
  </body>
</html>

<style is:global>
  main,
  footer {
    padding-inline: 1rem;
  }

  main {
    padding-block: 1rem;
  }

  footer {
    padding-block: 0.5rem 1rem;
    border-block-start: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .disclaimer {
    margin-block-start: 0;
  }
</style>
