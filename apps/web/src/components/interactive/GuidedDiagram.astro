---
import Diagram from '../diagrams/Diagram.astro';
import Cite from '../Cite.astro';
import { defaultLocale } from '../../i18n/locales.ts';
import { getMessages } from '../../i18n/messages.ts';
import type { InteractiveBlock } from '../../lib/interactive.ts';
interface Props {
  block: Extract<InteractiveBlock, { kind: 'guided-diagram' }>;
}
const { block } = Astro.props;
const t = getMessages(Astro.locals.locale ?? defaultLocale);
---

<section data-guided aria-label={block.title}>
  <h2>{block.title}</h2>
  <p>{block.fallback}</p>
  <Diagram name={block.diagram} initialState={block.steps[0]?.state ?? 'diastole'} paused />
  <div data-navigation hidden>
    <button type="button" data-previous>
      {t['interactive.previous']}
    </button>
    <output aria-live="polite"></output>
    <button type="button" data-next>
      {t['interactive.next']}
    </button>
    <button type="button" data-motion>
      {t['interactive.motion']}
    </button>
  </div>
  <ol>
    {block.steps.map((step, index) => (
      <li data-step={index} data-state={step.state}>
        <h3>{step.title}</h3>
        <p>
          {step.text} <Cite refs={step.sourceRefs} />
        </p>
      </li>
    ))}
  </ol>
</section>
<script>
  function required<T extends Element>(root: Element, selector: string): T {
    const element = root.querySelector<T>(selector);
    if (!element) throw new Error(`Missing guided control ${selector}`);
    return element;
  }
  for (const root of document.querySelectorAll<HTMLElement>('[data-guided]')) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const radios = [...root.querySelectorAll<HTMLInputElement>('.diagram input[type="radio"]')];
    const previous = required<HTMLButtonElement>(root, '[data-previous]');
    const next = required<HTMLButtonElement>(root, '[data-next]');
    let index = 0;
    function select(value: number) {
      index = Math.max(0, Math.min(steps.length - 1, value));
      steps.forEach((step, i) => {
        step.hidden = i !== index;
      });
      radios.forEach((radio) => {
        radio.checked = radio.value === steps[index]?.dataset['state'];
      });
      required<HTMLOutputElement>(root, 'output').textContent = `${index + 1} / ${steps.length}`;
      previous.disabled = index === 0;
      next.disabled = index === steps.length - 1;
    }
    previous.addEventListener('click', () => select(index - 1));
    next.addEventListener('click', () => select(index + 1));
    radios.forEach((radio) =>
      radio.addEventListener('change', () =>
        select(steps.findIndex((step) => step.dataset['state'] === radio.value)),
      ),
    );
    required<HTMLButtonElement>(root, '[data-motion]').addEventListener('click', () => {
      const pause = required<HTMLInputElement>(root, '.diagram-pause input');
      pause.checked = !pause.checked;
      required<HTMLButtonElement>(root, '[data-motion]').setAttribute(
        'aria-pressed',
        String(!pause.checked),
      );
    });
    required<HTMLElement>(root, '[data-navigation]').hidden = false;
    select(0);
  }
</script>
<style>
  [data-navigation] {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  [data-navigation][hidden] {
    display: none;
  }

  @media print {
    [data-navigation] {
      display: none;
    }

    li[hidden] {
      display: list-item !important;
    }
  }
</style>
