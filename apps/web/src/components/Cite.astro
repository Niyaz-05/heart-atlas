---
import { citationNumbers } from '../lib/citations.ts';
import { defaultLocale } from '../i18n/locales.ts';
import { getMessages } from '../i18n/messages.ts';

// Marks a statement with the numbers of the article sources that support it: <Cite n={2} />.
interface Props {
  n?: number | number[];
  refs?: string[];
}

const numbers = citationNumbers(
  Astro.props,
  Astro.locals.sources ?? Array.from({ length: Astro.locals.sourceCount ?? 0 }, () => ({})),
);
const t = getMessages(Astro.locals.locale ?? defaultLocale);
---

<sup class="cite">
  [
  {numbers.map((n, i) => (
    <>
      {i > 0 && ', '}
      <a href={`#source-${n}`} aria-label={t['sources.cite'].replace('{n}', String(n))}>
        {n}
      </a>
    </>
  ))}
  ]
</sup>

<style>
  .cite {
    line-height: 0;
  }
</style>
