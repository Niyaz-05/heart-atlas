---
import type { PresetId } from '@heart-atlas/heart-clock';
import { getMessages } from '../../i18n/messages.ts';
import HeartClockDemo, {
  heartClockMessageKeys,
  type HeartClockMessages,
} from './HeartClockDemo.tsx';

interface Props {
  locale: string;
  /** The article's preset; the reader can switch between it and normal. */
  preset: Exclude<PresetId, 'normal'>;
}

const { locale, preset } = Astro.props;
const t = getMessages(locale);
const messages = Object.fromEntries(
  heartClockMessageKeys.map((key) => [key, t[key]]),
) as HeartClockMessages;
---

<section class="clock" aria-labelledby="in-model" data-pagefind-ignore>
  <h2 id="in-model">{t['heartClock.inModel']}</h2>
  <p class="schematic" role="note">
    {t['heartClock.schematic']}
  </p>
  <HeartClockDemo
    client:visible
    locale={locale}
    messages={messages}
    presets={['normal', preset]}
    preset={preset}
  />
</section>

<style>
  .clock {
    display: grid;
    gap: 1rem;
    margin-block: 2rem;
  }

  h2,
  .schematic {
    margin: 0;
  }

  .schematic {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-inline-start: 4px solid var(--color-accent);
  }
</style>
