---
import { localeCodes, locales } from '../i18n/locales.ts';
import { getMessages } from '../i18n/messages.ts';
import { switchLocalePath } from '../i18n/paths.ts';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getMessages(locale);
const base = import.meta.env.BASE_URL;
---

<nav aria-label={t['nav.language']}>
  <ul>
    {localeCodes.map((code) => (
      <li>
        <a
          href={switchLocalePath(Astro.url.pathname, base, code, localeCodes)}
          lang={code}
          hreflang={code}
          aria-current={code === locale ? 'page' : undefined}
        >
          {locales[code]?.name}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a[aria-current='page'] {
    font-weight: 700;
    text-decoration: none;
  }
</style>
