---
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>Heart Atlas</title>
  </head>
  <body>
    <main>
      <h1>Heart Atlas</h1>
      <p>An open-source interactive atlas of the heart. Coming soon.</p>
    </main>
  </body>
</html>

<style>
  main {
    max-inline-size: 40rem;
    margin-inline: auto;
    padding-inline: 1rem;
    font-family: system-ui, sans-serif;
  }
</style>
