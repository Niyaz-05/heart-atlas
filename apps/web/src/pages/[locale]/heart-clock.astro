---
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import HeartClockDemo, {
  heartClockMessageKeys,
  type HeartClockMessages,
} from '../../components/heart-clock/HeartClockDemo.tsx';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeCodes } from '../../i18n/locales.ts';
import { getMessages } from '../../i18n/messages.ts';

export const getStaticPaths = (() =>
  localeCodes.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getMessages(locale);
const messages = Object.fromEntries(
  heartClockMessageKeys.map((key) => [key, t[key]]),
) as HeartClockMessages;

// Sources behind the model: docs/plans/2026-10-11-stage-2-heart-clock.md. Titles stay in the
// language of publication.
const sources = [
  {
    text: 'StatPearls. Electrocardiogram. Updated 2023-06-05.',
    href: 'https://www.statpearls.com/point-of-care/20969',
  },
  {
    text: 'StatPearls. Physiology, Cardiac Cycle. Updated 2022-10-03.',
    href: 'https://www.statpearls.com/point-of-care/786',
  },
  {
    text: 'Weissler AM, Harris WS, Schoenfeld CD. Systolic time intervals in heart failure in man. Circulation. 1968;37(2):149–159.',
    href: 'https://doi.org/10.1161/01.CIR.37.2.149',
  },
  {
    text: 'McSharry PE, Clifford GD, Tarassenko L, Smith LA. A dynamical model for generating synthetic electrocardiogram signals. IEEE Trans Biomed Eng. 2003;50(3):289–294.',
    href: 'https://doi.org/10.1109/TBME.2003.808805',
  },
];
---

<BaseLayout locale={locale} title={t['heartClock.title']} description={t['heartClock.intro']}>
  <h1>{t['heartClock.title']}</h1>
  <p>{t['heartClock.intro']}</p>
  <p class="schematic" role="note">
    {t['heartClock.schematic']}
  </p>
  <HeartClockDemo client:visible locale={locale} messages={messages} />
  <h2>{t['heartClock.sources']}</h2>
  <ol class="sources">
    {sources.map((source) => (
      <li>
        <a href={source.href} lang="en">
          {source.text}
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .schematic {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-inline-start: 4px solid var(--color-accent);
  }

  .sources {
    padding-inline-start: 1.5rem;
    font-size: 0.875rem;
  }
</style>
